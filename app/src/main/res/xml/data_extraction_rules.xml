<?xml version="1.0" encoding="utf-8"?>
<!-- The preferences hold both accounts' tokens: they stay on this phone,
     neither in a cloud backup nor in a transfer to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
